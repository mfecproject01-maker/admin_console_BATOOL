# ─────────────────────────────────────────────────────────────
# BA Tool Backend — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase, Render Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. Application will refuse to start without it.
SECRET_KEY=

# JWT token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Runtime environment: "development" or "production"
# In production: API docs are hidden, errors are sanitized
ENVIRONMENT=development

# Port (Render sets this automatically; leave blank locally)
PORT=8000

# ─── Admin Superadmin Credentials ─────────────────────────────
# These are used to seed the initial superadmin account.
# Change ADMIN_PASSWORD before deployment. Application will refuse
# to start with a blank or trivially weak password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Do NOT include "null" — it permits file:// and sandboxed iframe requests.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5501,http://127.0.0.1:5500,http://127.0.0.1:5501

# Optional: regex for Vercel preview URL branches (leave blank if not needed)
# Example: https://your-app(-[a-z0-9]+)?\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# ─── Optional Integrations ────────────────────────────────────
# Anthropic API key (only needed if AI features are enabled)
ANTHROPIC_API_KEY=
